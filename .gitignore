# Node
node_modules/
dist/
.vite/
.tmp/
# We use bun; npm/yarn/pnpm lockfiles must never be committed.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Rust / Tauri
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/

# Bundled binaries (fetched by scripts/download-tart.sh)
src-tauri/binaries/
src-tauri/resources/tart/
src-tauri/resources/third-party/

# OS
.DS_Store

# Editor
.vscode/
.idea/

# Logs / local
*.log
.context/

# Local signing/release secrets — never commit (use .env.example as a template)
.env
.env.local

# Superpowers / Claude Code internal docs — never commit
docs/superpowers/

# Superpowers brainstorming visual companion (local-only)
.superpowers/

# Material Icon Theme SVGs copied at build (see vite.config.ts)
public/file-icons/

# Mobile companion app (mobile/). The Rust/Node ignores above contain a slash,
# so git anchors them to the repo root and they do NOT cover mobile/ — hence
# these explicit entries.
mobile/node_modules/
mobile/dist/
mobile/.vite/
mobile/src-tauri/target/
# Everything under gen/ is generated: tauri-build rewrites the schemas on every
# build, and `tauri ios init` regenerates the Xcode project from
# tauri.conf.json plus the plugins' build scripts (which is where the
# entitlements come from) — so it stays a local, per-machine artifact.
mobile/src-tauri/gen/
# Xcode/SPM writes this when it resolves a plugin's Swift package, and what it
# pins comes from the Tauri package copied in at build time.
mobile/src-tauri/plugins/*/ios/Package.resolved

# Remote relay Worker (relay/). Same story as mobile/: the root-anchored
# entries above do not reach into it.
relay/node_modules/
relay/.wrangler/
relay/dist/
