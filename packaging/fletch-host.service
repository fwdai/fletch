# A systemd unit for the headless Fletch host, as a **user** unit by default:
# the host runs as you, not as root.
#
# Everything it touches is yours — your `~/.local/share/fletch-host` data dir
# (database, and the checkouts and RPC mailboxes under it), the provider CLI
# logins in your home directory — and on Linux the container sandbox maps its
# files back to this same user, which a root-owned service would defeat.
#
# Installing it:
#
#   fletch-host service install                        # user unit, enabled, started
#   fletch-host service install --system --user fletch # /etc/systemd/system
#   fletch-host service uninstall
#
# This file is a **template**, and the only copy of the unit: `fletch-host
# service install` compiles it in with `include_str!` and fills in the four
# placeholders below, so a unit written by the CLI and one written by hand
# cannot drift. Each appears in the body as its name in doubled curly braces;
# to install by hand, substitute all four and then `systemctl --user
# daemon-reload && systemctl --user enable --now fletch-host`.
#
#   EXEC        absolute path of the fletch-host binary
#   SERVE_ARGS  the rest of the command line after `serve` — always
#               `--data-dir <abs>`, plus `--port`/`--name` if you asked for
#               them. Resolved absolutely because an init system's environment
#               is not your shell's: `$XDG_DATA_HOME` and even `$HOME` may be
#               unset or different, and the service must open the same data dir
#               the CLI subcommands talk to.
#   USER        `User=<name>` for a system unit; empty for a user unit
#   WANTED_BY   `default.target` for a user unit, `multi-user.target` for a
#               system unit
#
# A user unit stops when you log out unless lingering is on:
#
#   loginctl enable-linger $USER
#
# Logs: journalctl --user -u fletch-host -f
# See crates/fletch-host/README.md for the rest.

[Unit]
Description=Fletch host (headless agent engine)
Documentation=https://github.com/fwdai/fletch/blob/main/crates/fletch-host/README.md
# Pairing needs an address to advertise, and the relay needs a route out.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{EXEC}} serve{{SERVE_ARGS}}
{{USER}}
# Only on failure: `serve` exits 0 on SIGTERM (`systemctl --user stop`), and a
# clean stop must stay stopped.
Restart=on-failure
RestartSec=5
# Logs go to stderr, which systemd captures into the journal.
Environment=RUST_LOG=info
# `fletch-host github login` signs in through GitHub's device flow, which needs
# the client id of an OAuth app that has it enabled. The desktop bakes its own
# in at build time; a host reads it from here. Uncomment and set yours.
#Environment=QUORUM_GITHUB_CLIENT_ID=
# Or skip the sign-in and hand the host a token, which then stays out of its
# database: either of these, the environment variable first (see the README).
#Environment=FLETCH_GITHUB_TOKEN=
#LoadCredential=github_token:/etc/fletch/github_token
# Agent processes are children of this one, and `serve` kills them itself on
# SIGTERM; give that a moment before systemd reaches for SIGKILL.
TimeoutStopSec=30

[Install]
WantedBy={{WANTED_BY}}
