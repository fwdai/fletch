<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  A launchd **user agent**: the macOS counterpart of
  packaging/fletch-host.service, same shape, same reasons — it runs as you, so
  the database, the checkouts and the provider CLI logins are all yours.

  Installing it:

    fletch-host service install
    fletch-host service uninstall

  This file is a template, and the only copy of the agent: `fletch-host service
  install` compiles it in with `include_str!` and fills in the three
  placeholders below, so an agent written by the CLI and one written by hand
  cannot drift. Each appears in the body as its name in doubled curly braces.
  launchd expands neither `~` nor `$HOME`, which is half of why they exist; the
  other half is that a launchd agent's environment is not your shell's, so the
  data dir has to be named rather than re-derived.

    EXEC         absolute path of the fletch-host binary
    ARG_STRINGS  the rest of ProgramArguments, one indented
                 <string>…</string> per argument, starting with `serve` and
                 then `--data-dir <abs>` plus `--port`/`--name` if you asked
                 for them
    LOG_PATH     absolute path of the log file

  To install by hand, substitute all three, write the result to
  ~/Library/LaunchAgents/com.fletch.host.plist and then

    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.fletch.host.plist

  Stop it with `launchctl bootout gui/$(id -u)/com.fletch.host`.
  Logs: tail -f ~/Library/Logs/fletch-host.log
  A Mac that sleeps is a host that answers nothing: `sudo pmset -a sleep 0`
  (or Energy Saver → "Prevent automatic sleeping").
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fletch.host</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{EXEC}}</string>
{{ARG_STRINGS}}
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on failure only: `serve` exits 0 on SIGTERM, and a stop that
         was asked for must stay stopped. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
        <!-- `fletch-host github login` needs the client id of an OAuth app
             with the device flow enabled (see the README).
        <key>QUORUM_GITHUB_CLIENT_ID</key>
        <string></string>
        -->
    </dict>

    <!-- Logs go to stderr; launchd has no journal, so name a file. -->
    <key>StandardOutPath</key>
    <string>{{LOG_PATH}}</string>
    <key>StandardErrorPath</key>
    <string>{{LOG_PATH}}</string>
</dict>
</plist>
