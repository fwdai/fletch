#!/bin/sh
# Box guest entrypoint, run as the workload under libkrun's init after it
# mounts the base image read-only on /.
#
# Everything comes from the environment (krun_set_env) or from disk; argv is
# never used because libkrun's init re-splits it. Required:
#   FLETCH_BOX_WRITABLE_ROOT   host path of the agent's writable root  -> /data/ws
#   FLETCH_BOX_RPC_DIR         host path of the RPC mailbox           -> /data/rpc
#   FLETCH_BOX_HOME            host path of $HOME                     -> /data/home
#   FLETCH_BOX_AUTHORIZED_KEY  one OpenSSH public key line, the host's key for this box
# Optional: FLETCH_BOX_ID, shown in log lines; FLETCH_BOX_SHARES=<n> with
# FLETCH_BOX_SHARE_<i>=ro:<path> | rw:<path> for i < n, the folders the user
# shared with this box, each the virtio-fs device tagged fletch-share-<i>.
#
# Console markers the host reads, in order:
#   FLETCH_HOSTKEY <type> <base64>   the guest's ssh host key (persisted on /data)
#   FLETCH_READY                     ssh (vsock 22), egress (6000) and control (5000) are live
#   FLETCH_INIT_ERROR <text>         then a non-zero exit: a box that cannot be reached must
#                                    never look ready
set -eu

SSH_VSOCK=22 EGRESS_VSOCK=6000 CONTROL_VSOCK=5000 EGRESS_PORT=8899
# Containers' egress: every outside name resolves to SENTINEL (RFC 2544's
# benchmarking range, never a real host), whose ports 80 and 443 lead to these.
SENTINEL=198.18.0.1 SENTINEL_HTTP_PORT=8898 SENTINEL_TLS_PORT=8897
GUEST=/opt/fletch/bin/fletch-guest
DATA_DEV=/dev/vdb

step="starting"
failed=
# Markers go to stdout: that is the console the host parses.
fail() { failed=1; echo "FLETCH_INIT_ERROR $*"; exit 1; }
trap '[ $? -eq 0 ] || [ -n "$failed" ] || echo "FLETCH_INIT_ERROR init failed while $step"' EXIT

step="checking the environment"
for var in FLETCH_BOX_WRITABLE_ROOT FLETCH_BOX_RPC_DIR FLETCH_BOX_HOME FLETCH_BOX_AUTHORIZED_KEY; do
  eval "value=\${$var:-}"
  [ -n "$value" ] || fail "$var is not set in the kernel environment"
done
# Binds must happen parent first (a later mount on an ancestor would hide an
# earlier one), and HOME is the only plausible ancestor; refuse the other order.
case "$FLETCH_BOX_HOME" in
  "$FLETCH_BOX_WRITABLE_ROOT"/*|"$FLETCH_BOX_RPC_DIR"/*) fail "FLETCH_BOX_HOME may not lie inside the writable root or the rpc dir";;
esac
echo "fletch-init: box ${FLETCH_BOX_ID:-?}"

step="mounting tmpfs"
# /var/tmp comes after the system overlays: the one on /var would hide it.
for dir in /tmp /run; do
  mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs "$dir"
done
mkdir -m 755 /run/sshd   # sshd's privilege separation directory, needed even with -i
echo fletch-box > /proc/sys/kernel/hostname

step="mounting /data"
[ -b "$DATA_DEV" ] || fail "no data disk at $DATA_DEV"
# The filesystem stops 4 MiB short of the device so mkfs's wipe of the tail cannot
# reach the end of the host file, which stock libkrun would truncate (Calina's
# init; its libkrun patch 3 covers the rest). Lazy init keeps the sparse host
# file sparse.
format_data() {
  size_kib=$(( $(blockdev --getsize64 "$DATA_DEV") / 1024 - 4096 ))
  mkfs.ext4 -q -F -L fletch-data -E nodiscard,lazy_itable_init=1,lazy_journal_init=1 \
    "$DATA_DEV" "${size_kib}k"
}
# discard: deleted files give their space back to the host file. noinit_itable:
# no background zeroing of inode tables, which would fill the sparse file.
mount_data() {
  mount -t ext4 -o nosuid,nodev,discard,noinit_itable "$DATA_DEV" /data
}
# A blank disk (the host hands over an empty sparse file) is formatted. One with
# a filesystem that does not mount gets fsck; only a disk fsck cannot repair is
# formatted again, since nothing else could ever read it. A disk fsck calls sound
# that still does not mount is not the disk's fault and is never wiped.
if [ -z "$(blkid "$DATA_DEV")" ]; then
  echo "fletch-init: formatting the data disk"
  format_data
  mount_data
elif ! mount_data; then
  echo "fletch-init: the data disk does not mount; checking it" >&2
  # 0 clean, 1 and 2 repaired, 4 and up errors left or nothing to check.
  fsck_status=0
  e2fsck -y "$DATA_DEV" || fsck_status=$?
  if [ "$fsck_status" -ge 4 ]; then
    echo "fletch-init: the data disk cannot be repaired (fsck exit $fsck_status); formatting it, its files are lost" >&2
    format_data
  fi
  mount_data || fail "the data disk still does not mount (fsck exit $fsck_status)"
fi
# tools/ is where a tools-disk build installs the provider CLIs (packaging/box-image/tools),
# as agent over ssh; on a workspace disk it stays empty.
mkdir -p /data/ws /data/rpc /data/home /data/ssh /data/run /data/tools
chown agent:agent /data/ws /data/rpc /data/home /data/run /data/tools
chmod 700 /data/run   # env files, 0600 and owned by agent, land here

step="mounting layers"
# Every disk after the data disk is told apart by content, not by its letter:
# an erofs with a /.fletch-layer marker is a layer (devtools, browser,
# containers, ...), an ext4 is a tools disk (one provider's CLI each; a box may
# carry several), a disk with no filesystem (a test's script disk) is left
# alone. Layers are mounted read-only under /run/layers.
layers=""
tools_devs=""
n=0
for dev in /dev/vd[c-z]; do
  [ -b "$dev" ] || continue
  type=$(blkid -o value -s TYPE "$dev" 2>/dev/null || true)
  case "$type" in
    erofs)
      mnt=/run/layers/$n
      mkdir -p "$mnt"
      mount -t erofs -o ro,nosuid,nodev "$dev" "$mnt" || fail "the layer disk $dev does not mount"
      [ -f "$mnt/.fletch-layer" ] || fail "$dev is an erofs disk without a /.fletch-layer marker"
      layers="$mnt $layers"
      n=$((n + 1))
      ;;
    ext4)
      tools_devs="$tools_devs $dev"
      ;;
    "") ;;
    *) fail "$dev holds a $type filesystem, which is neither a layer (erofs) nor a tools disk (ext4)";;
  esac
done
[ "$n" -eq 0 ] || echo "fletch-init: $n layer(s): $(cat /run/layers/*/.fletch-layer | tr -d '\n')"

step="mounting the system"
# /usr, /etc and /var are each one overlay: the base's directory, the layers'
# on it (later disks on top), and above them the box's own changes (`sudo
# apt-get install`), kept on the data disk. Those belong to the image they
# were made on: over another image's files they are how a system breaks, so
# a box that boots another image drops them. Binaries already running keep
# their inodes; every later lookup goes through the overlay.
image=$(cat /etc/fletch-image)
if [ "$(cat /data/sys/image 2>/dev/null)" != "$image" ]; then
  if [ -d /data/sys ]; then
    echo "fletch-init: dropping the system changes made on another image"
  fi
  rm -rf /data/sys
  mkdir -m 700 /data/sys
  echo "$image" > /data/sys/image
fi
for dir in usr etc var; do
  lower=""
  for mnt in $layers; do
    [ -d "$mnt/$dir" ] && lower="$lower$mnt/$dir:"
  done
  mkdir -p "/data/sys/$dir/upper" "/data/sys/$dir/work"
  mount -t overlay overlay \
    -o "lowerdir=$lower/$dir,upperdir=/data/sys/$dir/upper,workdir=/data/sys/$dir/work" "/$dir" ||
    fail "the system overlay on /$dir does not mount"
done
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /var/tmp

step="binding the host paths"
# Path identity (§6.2): the host's absolute paths exist in the guest, bound from
# the data disk. The root is read-only erofs, so the first component of each
# path is shadowed with a tmpfs first. Shadowing a directory the guest itself
# lives in would break it, so those are refused.
# The directories between a path and that tmpfs belong to agent, like the home
# most of them sit in: the guest user makes their other entries (a tenant's
# mailbox and writable root, the toolchain cache). Set at every boot, not only
# when made, since those in the home persist on the data disk; -h, so a link
# the guest user left there is not followed.
bind_identity() { # <guest path> <data dir>
  case "$1" in /?*/?*) ;; *) fail "$1 is not an absolute path with two components or more";; esac
  top=${1#/}; top=/${top%%/*}
  case "$top" in
    /bin|/boot|/data|/dev|/etc|/lib|/lib64|/opt|/proc|/run|/sbin|/sys|/tmp|/usr|/var)
      fail "cannot place $1 under $top: it would shadow the guest's own files";;
  esac
  [ -d "$top" ] || fail "no $top directory in the image to mount $1 under"
  mountpoint -q "$top" || mount -t tmpfs -o mode=755,nosuid,nodev tmpfs "$top"
  mkdir -p "$1"
  dir=${1%/*}
  while [ "$dir" != "$top" ]; do
    chown -h agent:agent "$dir"
    dir=${dir%/*}
  done
  mount --bind "$2" "$1"
}
bind_identity "$FLETCH_BOX_HOME" /data/home
bind_identity "$FLETCH_BOX_RPC_DIR" /data/rpc
bind_identity "$FLETCH_BOX_WRITABLE_ROOT" /data/ws

# The folders the user shared with this box, each at its own host path from its
# virtio-fs device, after HOME so one inside it lands on top, and in the host's
# order (parents first). Read-only is enforced on the host side; `ro` here only
# makes the mount say so. A share that does not mount fails the boot: an agent
# told about a folder must never find an empty directory in its place.
mount_share() { # <tag> <ro|rw> <guest path>
  step="mounting the shared folder $3"
  case "$3" in /Users/?*|/Volumes/?*) ;; *) fail "cannot mount $3: shared folders sit under /Users or /Volumes";; esac
  top=${3#/}; top=/${top%%/*}
  mountpoint -q "$top" || mount -t tmpfs -o mode=755,nosuid,nodev tmpfs "$top"
  mkdir -p "$3"
  opts=nosuid,nodev
  [ "$2" = ro ] && opts="ro,$opts"
  mount -t virtiofs -o "$opts" "$1" "$3"
}
shares=${FLETCH_BOX_SHARES:-0}
i=0
while [ "$i" -lt "$shares" ]; do
  eval "share=\${FLETCH_BOX_SHARE_$i:-}"
  [ -n "$share" ] || fail "FLETCH_BOX_SHARE_$i is not set"
  mount_share "fletch-share-$i" "${share%%:*}" "${share#*:}"
  i=$((i + 1))
done

step="mounting the tools disks"
# Each disk was built by booting a box with it as /data, so its CLI sits under
# its tools/ directory (packaging/box-image/tools); only that part is exposed.
# One disk is bound on /opt/fletch/tools; several are overlaid there, the
# first disk (the box owner's provider) on top, so every provider's CLI is at
# /opt/fletch/tools/<provider>/bin and the one codegraph copy that wins is the
# owner's.
lower=""
n=0
for dev in $tools_devs; do
  mnt=/run/tools/$n
  mkdir -p "$mnt"
  mount -t ext4 -o ro,nosuid,nodev "$dev" "$mnt" || fail "the tools disk $dev does not mount"
  [ -d "$mnt/tools" ] || fail "the tools disk $dev has no tools/ directory"
  lower="$lower$mnt/tools:"
  n=$((n + 1))
done
case "$n" in
  0) ;;
  1) mount --bind /run/tools/0/tools /opt/fletch/tools ;;
  *) mount -t overlay overlay -o "ro,nosuid,nodev,lowerdir=${lower%:}" /opt/fletch/tools || fail "the tools overlay does not mount" ;;
esac
[ "$n" -eq 0 ] || echo "fletch-init: $n tools disk(s): $(ls /opt/fletch/tools | tr '\n' ' ')"

step="preparing ssh"
# The host key persists with the workspace, so the host learns it once.
[ -f /data/ssh/host_key ] || ssh-keygen -q -t ed25519 -N '' -C fletch-box -f /data/ssh/host_key
chmod 600 /data/ssh/host_key
read -r keytype key _ < /data/ssh/host_key.pub
echo "FLETCH_HOSTKEY $keytype $key"
# Root-owned and 0644 satisfies sshd's StrictModes (owner must be root or the user).
printf '%s\n' "$FLETCH_BOX_AUTHORIZED_KEY" > /data/ssh/authorized_keys
chmod 644 /data/ssh/authorized_keys

# A fletch-guest service prints one line once it listens, then moves its stdout
# to the console. Reading that line through a FIFO is what makes FLETCH_READY
# below mean "the host can connect now", not "the processes were forked".
start() {
  mkfifo /run/fletch-start
  "$@" >/run/fletch-start &
  read -r line </run/fletch-start || fail "$2 did not start"
  echo "$line"
  rm /run/fletch-start
}
step="starting sshd on vsock $SSH_VSOCK"
start "$GUEST" vsock-listen "$SSH_VSOCK" -- /usr/sbin/sshd -i -e -f /etc/ssh/sshd_config.fletch
step="starting the egress loopback"
start "$GUEST" egress-loopback "$EGRESS_PORT" "$EGRESS_VSOCK"

# The container runtime, when the containers layer is aboard. No docker process
# runs until something connects to /run/docker.sock, which the docker group
# (the agent is in it) may open; the first connection starts dockerd on it.
if [ -x /usr/bin/dockerd ]; then
  step="enabling forwarding for containers"
  # dockerd leaves it to whoever starts it under its nftables firewall.
  echo 1 > /proc/sys/net/ipv4/ip_forward
  step="listening on the docker socket"
  start "$GUEST" socket-activate /run/docker.sock -- /usr/bin/dockerd -H fd:// 2>>/var/log/docker.log
  chgrp docker /run/docker.sock
  chmod 660 /run/docker.sock

  # Containers and image builds get out with no proxy settings: the daemon's
  # `dns` is the bridge's address, where sentinel-dns answers every outside
  # name with SENTINEL, and what they open to SENTINEL on 80 and 443 is
  # DNAT'd to transparent-egress, which tunnels it through the egress proxy
  # to the host it names. Both listen on the bridge's address only, so the
  # guest's own lookups (its empty resolv.conf means 127.0.0.1) never get the
  # sentinel and `fletch-guest listeners` leaves their ports out; that address
  # exists once dockerd has made the bridge, hence nonlocal binds.
  step="starting the containers' egress"
  bridge=$(jq -r .bip /etc/docker/daemon.json)
  bridge=${bridge%/*}
  echo 1 > /proc/sys/net/ipv4/ip_nonlocal_bind
  start "$GUEST" sentinel-dns "$bridge:53" "$SENTINEL"
  start "$GUEST" transparent-egress "$bridge:$SENTINEL_HTTP_PORT" "$bridge:$SENTINEL_TLS_PORT" "$EGRESS_VSOCK"
  # Ahead of Docker's own NAT chains (priority dstnat).
  nft -f - <<EOF
table ip fletch-egress {
  chain prerouting {
    type nat hook prerouting priority dstnat - 10;
    ip daddr $SENTINEL tcp dport 80 dnat to $bridge:$SENTINEL_HTTP_PORT
    ip daddr $SENTINEL tcp dport 443 dnat to $bridge:$SENTINEL_TLS_PORT
  }
}
EOF
fi

step="starting the control listener"
start "$GUEST" wait-stop "$CONTROL_VSOCK"
control=$!

echo FLETCH_READY
wait "$control"   # returns once the host sent `stop`

step="stopping"
echo "fletch-init: stop requested"
# Everything but PID 1 and this shell: sessions, sshd, the relays, the services.
kill -TERM -1 2>/dev/null || true
sleep 0.2
kill -KILL -1 2>/dev/null || true
sync
# Shared folders, the last mounted first: one may lie inside another.
i=$shares
while [ "$i" -gt 0 ]; do
  i=$((i - 1))
  eval "share=\${FLETCH_BOX_SHARE_$i}"
  umount "${share#*:}" || echo "fletch-init: could not unmount ${share#*:}" >&2
done
# /data cannot be unmounted: the system overlays, whose binaries this very
# step runs, keep it in use (and the containers' mounts may). Made read-only
# instead, its journal is flushed and it is marked clean for the next boot.
mount -o remount,ro /data
echo "fletch-init: /data read-only, powering off"
# libkrun's init powers the VM off when its workload exits.
exit 0
