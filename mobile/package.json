{
  "name": "fletch-mobile",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "if [ -f .env ]; then set -a; . ./.env; set +a; fi; tauri",
    "ios:init": "bun run tauri ios init",
    "release:ios": "bun run tauri ios build --export-method app-store-connect && xcodebuild -exportArchive -allowProvisioningUpdates -archivePath src-tauri/gen/apple/build/fletch-mobile_iOS.xcarchive -exportOptionsPlist src-tauri/ExportOptions.upload.plist -exportPath src-tauri/gen/apple/build/upload",
    "icons": "node scripts/generate-icons.mjs",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.2.5",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.1",
    "partial-json": "^0.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.7.3",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
