{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "root": false,
  "extends": ["../biome.json"],
  "vcs": {
    "enabled": false
  },
  "files": {
    "includes": ["!src-tauri", "!bun.lock", "!dist"]
  },
  "overrides": [
    {
      "includes": ["src/styles/*.css"],
      "linter": {
        "rules": {
          "style": { "noDescendingSpecificity": "off" },
          "complexity": { "noImportantStyles": "off" }
        }
      }
    }
  ]
}
