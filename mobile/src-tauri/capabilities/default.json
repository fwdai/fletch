{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "Everything the phone needs: a Rust-side WebSocket to the paired host, a settings file in the app data dir, local notifications and the fletch:// pairing link.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "websocket:default",
    "notification:default",
    "deep-link:default",
    "fs:allow-app-data-read",
    "fs:allow-app-data-write",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/fletch" }, { "path": "$APPDATA/fletch/*" }]
    }
  ]
}
